<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mi Generador QR Sin Anuncios</title>
  <script type="text/javascript" src="https://unpkg.com/qr-code-styling@1.6.0-rc.1/lib/qr-code-styling.js"></script>
  <style>
    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: #0f172a;
      color: #f8fafc;
      display: flex;
      justify-content: center;
      padding: 30px 15px;
      margin: 0;
    }
    .card {
      background: #1e293b;
      padding: 25px;
      border-radius: 16px;
      max-width: 440px;
      width: 100%;
      box-shadow: 0 10px 25px rgba(0,0,0,0.4);
    }
    h2 { margin-top: 0; text-align: center; font-size: 1.3rem; }
    label { display: block; margin: 12px 0 5px; font-size: 0.9rem; color: #cbd5e1; }
    input[type="text"], select, input[type="file"] {
      width: 100%;
      padding: 10px;
      border-radius: 8px;
      border: 1px solid #334155;
      background: #0f172a;
      color: #fff;
      box-sizing: border-box;
    }
    .row { display: flex; gap: 10px; }
    .row > div { flex: 1; }
    input[type="color"] {
      width: 100%;
      height: 40px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      background: none;
    }
    #canvas-container {
      background: #ffffff;
      margin: 20px auto;
      padding: 15px;
      border-radius: 12px;
      width: fit-content;
      display: flex;
      justify-content: center;
    }
    .btns { display: flex; gap: 10px; margin-top: 15px; }
    button {
      flex: 1;
      padding: 12px;
      border: none;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
      background: #38bdf8;
      color: #0f172a;
      font-size: 0.95rem;
    }
    button:hover { background: #7dd3fc; }
  </style>
</head>
<body>
  <div class="card">
    <h2>Generador QR Estático</h2>

    <label>Enlace (Linktree, web, etc.)</label>
    <input type="text" id="urlInput" value="https://linktr.ee/" oninput="actualizarQR()">

    <div class="row">
      <div>
        <label>Color de puntos</label>
        <input type="color" id="colorPuntos" value="#0f172a" oninput="actualizarQR()">
      </div>
      <div>
        <label>Color de fondo</label>
        <input type="color" id="colorFondo" value="#ffffff" oninput="actualizarQR()">
      </div>
    </div>

    <div class="row">
      <div>
        <label>Estilo de puntos</label>
        <select id="estiloPuntos" onchange="actualizarQR()">
          <option value="rounded">Redondeados</option>
          <option value="dots">Círculos</option>
          <option value="classy-rounded">Elegante</option>
          <option value="square">Cuadrados clásicos</option>
        </select>
      </div>
      <div>
        <label>Estilo de esquinas</label>
        <select id="estiloEsquinas" onchange="actualizarQR()">
          <option value="extra-rounded">Extra redondeadas</option>
          <option value="dot">Punto</option>
          <option value="square">Cuadradas</option>
        </select>
      </div>
    </div>

    <label>Logotipo central (opcional)</label>
    <input type="file" id="logoInput" accept="image/*" onchange="cargarLogo(event)">

    <div id="canvas-container"></div>

    <div class="btns">
      <button onclick="descargar('png')">Descargar PNG</button>
      <button onclick="descargar('svg')">Descargar SVG</button>
    </div>
  </div>

  <script>
    let logoBase64 = "";

    const qrCode = new QRCodeStyling({
      width: 260,
      height: 260,
      type: "svg",
      data: "https://linktr.ee/",
      image: "",
      dotsOptions: { color: "#0f172a", type: "rounded" },
      backgroundOptions: { color: "#ffffff" },
      cornersSquareOptions: { type: "extra-rounded" },
      imageOptions: { crossOrigin: "anonymous", margin: 6, imageSize: 0.35 }
    });

    qrCode.append(document.getElementById("canvas-container"));

    function actualizarQR() {
      qrCode.update({
        data: document.getElementById("urlInput").value || "https://linktr.ee/",
        dotsOptions: {
          color: document.getElementById("colorPuntos").value,
          type: document.getElementById("estiloPuntos").value
        },
        backgroundOptions: {
          color: document.getElementById("colorFondo").value
        },
        cornersSquareOptions: {
          type: document.getElementById("estiloEsquinas").value
        },
        image: logoBase64
      });
    }

    function cargarLogo(event) {
      const file = event.target.files[0];
      if (!file) { logoBase64 = ""; actualizarQR(); return; }
      const reader = new FileReader();
      reader.onload = function(e) {
        logoBase64 = e.target.result;
        actualizarQR();
      };
      reader.readAsDataURL(file);
    }

    function descargar(extension) {
      qrCode.download({ name: "mi-qr-personalizado", extension: extension });
    }
  </script>
</body>
</html>
