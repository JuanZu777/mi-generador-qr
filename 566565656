<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>QR Random de Ejemplo</title>
  <!-- Librería oficial de QR desde CDN -->
  <script src="https://unpkg.com/qr-code-styling@1.6.0-rc.1/lib/qr-code-styling.js"></script>
</head>
<body style="display:flex; flex-direction:column; align-items:center; justify-content:center; height:100vh; font-family:sans-serif; background:#0f172a; color:#fff;">

  <div id="qr" style="background:#fff; padding:20px; border-radius:16px;"></div>
  <p id="texto-url" style="margin-top:16px; color:#38bdf8;"></p>

  <script>
    // 1. Generar un enlace aleatorio de ejemplo (cámbialo por tu Linktree real)
    const idRandom = Math.floor(Math.random() * 10000);
    const enlace = `https://linktr.ee/usuario_demo_${idRandom}`;
    document.getElementById("texto-url").innerText = enlace;

    // 2. Crear el QR personalizado (estático, sin anuncios y permanente)
    const qr = new QRCodeStyling({
      width: 280,
      height: 280,
      data: enlace,
      dotsOptions: {
        color: "#0f172a",
        type: "rounded" // Opciones: "rounded", "dots", "classy", "square"
      },
      cornersSquareOptions: {
        color: "#0284c7",
        type: "extra-rounded"
      },
      backgroundOptions: {
        color: "#ffffff"
      }
    });

    // 3. Dibujarlo en pantalla
    qr.append(document.getElementById("qr"));
  </script>

</body>
</html>
